# Fictional local defaults only; copy to .env once, preserving any existing .env.
# Database/user/root settings initialize EMPTY volumes only. Changing them does
# not migrate an existing volume. Normal Compose down must preserve all data.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinema_dev
DB_USER=cinema_dev
DB_PASSWORD=fictional_dev_password
DB_ROOT_PASSWORD=fictional_dev_root_password

# Tests use TEST_DB_* exclusively; never point these at development storage.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_NAME=cinema_test
TEST_DB_USER=cinema_test
TEST_DB_PASSWORD=fictional_test_password
TEST_DB_ROOT_PASSWORD=fictional_test_root_password

# Before setup, each parallel verifier chooses a unique COMPOSE_PROJECT_NAME and
# distinct free DB_PORT/TEST_DB_PORT. Keep these settings for EVERY Compose and
# application command. Default service ports bind only to 127.0.0.1.
# COMPOSE_PROJECT_NAME=cinema_alice
