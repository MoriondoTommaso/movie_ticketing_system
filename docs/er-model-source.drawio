        <mxCell id="mandatory" value="* Required business minimum, validated by seed/auth; FK alone permits zero children.&#10;Each movie has one or more available languages and genres; the original language is included.&#10;A client has exactly one profile; an admin has none. No cross-table CHECK claims." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=22;fontFamily=Helvetica;fontColor=#18313b;fillColor=#eef5f6;strokeColor=#b8ccd0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="720" width="1740" height="110" />
        </mxCell>
        <mxCell id="local-title" value="SQL / local enforcement" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=28;fontFamily=Helvetica-Bold;fontColor=#18313b;fillColor=none;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="846" width="840" height="54" />
        </mxCell>
        <mxCell id="local" value="All tables: InnoDB, utf8mb4, NOT NULL attributes.&#10;FK updates/deletes: RESTRICT. IDs: unsigned INT.&#10;Email: UNIQUE, utf8mb4_bin; language/genre names: UNIQUE.&#10;Role: client/admin; payment type: credit/debit.&#10;Card: 13-19 ASCII digits; duplicate cards allowed.&#10;Flags: 0 or 1; capacity/runtime/quantity &gt; 0.&#10;Sold count/unit price/total &gt;= 0.&#10;Total = unit_price * quantity; money D(12,2).&#10;Services normalize email/card and reject empty strings.&#10;DATETIME: Europe/Rome wall time, converted by services." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=20;fontFamily=Helvetica;fontColor=#18313b;fillColor=none;strokeColor=none;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="900" width="840" height="280" />
        </mxCell>
        <mxCell id="service-title" value="Services / cross-row rules" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=28;fontFamily=Helvetica-Bold;fontColor=#18313b;fillColor=none;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="846" width="852" height="54" />
        </mxCell>
        <mxCell id="services" value="Seed/auth: role/profile and minimum-child completeness.&#10;Booking: stored principal; payment owner/active state;&#10;screening lock, capacity and counter/history consistency.&#10;Scheduling: theater lock; no overlapping screenings;&#10;future start, minute precision and opening hours.&#10;Helpers borrow the caller's transaction; no hidden commit.&#10;Seed reconciliation: sold counters equal purchase totals.&#10;Retain purchase references: deactivate, never delete.&#10;Direct ad-hoc writes are outside application guarantees." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=20;fontFamily=Helvetica;fontColor=#18313b;fillColor=none;strokeColor=none;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="900" width="852" height="280" />
        </mxCell>
        <mxCell id="indexes-title" value="Lookup / history indexes (plus primary, unique and remaining FK indexes)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=26;fontFamily=Helvetica-Bold;fontColor=#18313b;fillColor=none;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="1186" width="1740" height="50" />
        </mxCell>
        <mxCell id="indexes" value="screenings: (theater_id, starts_at), (movie_id, starts_at), (starts_at, screening_id)&#10;purchases: (client_id, purchased_at, purchase_id), (screening_id); payment_methods: (client_id, active)&#10;movie_languages: (language_id, movie_id); movie_genres: (genre_id, movie_id)&#10;Design correspondence review by all five teammates remains required; this artifact is not approval." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=20;fontFamily=Helvetica;fontColor=#18313b;fillColor=none;strokeColor=none;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="28" y="1240" width="1740" height="130" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>